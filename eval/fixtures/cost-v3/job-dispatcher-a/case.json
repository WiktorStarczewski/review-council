  "clean_controls": [
    {
      "id": "direct-tenant-read-isolation",
      "expected": true,
      "rationale": "Globally allocated IDs do not authorize another tenant to read a job."
    },
    {
      "id": "caller-payload-ownership",
      "expected": [
        3,
        3
      ],
      "rationale": "Mutating submission, snapshot, and handler data is permitted without altering stored payload ownership."
    },
    {
      "id": "exact-lease-deadline",
      "expected": [
        true,
        2,
        20.0,
        1
      ],
      "rationale": "Strictly before a deadline the lease is active; exactly at the deadline reclaim is intentional."
    },
    {
      "id": "expired-token-rejection",
      "expected": "leased",
      "rationale": "An expired token fails even when no recovery sweep has yet changed the stored job state."
    },
    {
      "id": "retry-cap-and-exhaustion",
      "expected": [
        [
          5.0,
          10.0,
          12.0,
          12.0
        ],
        "failed",
        1
      ],
      "rationale": "The delay cap applies to exponential waits, and the final attempt becomes terminal."
    },
    {
      "id": "queued-cancellation",
      "expected": [
        true,
        false,
        null,
        "cancelled"
      ],
      "rationale": "Waiting work cancels immediately; a repeated cancellation request is an idempotent no-op."
    },
    {
      "id": "new-insert-rollback",
      "expected": [
        1,
        "job-1",
        1,
        0
      ],
      "rationale": "A transaction rolls back newly indexed jobs and ID allocation, including in the aliased-record variant."
    },
    {
      "id": "sink-replay-deduplication",
      "expected": [
        true,
        1,
        2
      ],
      "rationale": "At-least-once replay of the identical event is valid and causes one consumer effect."
    },
    {
      "id": "zero-ack-progress-stop",
      "expected": [
        1,
        0,
        1,
        1
      ],
      "rationale": "A valid empty receipt retains pending work and terminates drain without spinning."
    },
    {
      "id": "transport-failure-retains-pending",
      "expected": [
        0,
        1,
        true,
        1,
        1
      ],
      "rationale": "A failed publish preserves pending work, and the next call can deliver it."
    },
    {
      "id": "unknown-ack-rejection",
      "expected": [
        1,
        1
      ],
      "rationale": "An acknowledgement outside the batch is rejected without marking pending events delivered."
    }
  ],
