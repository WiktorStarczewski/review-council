#!/bin/bash
# Fake codex CLI for rev unit tests. Never call the network.
# Records ENV and CWD next to argv (like the claude shim): a seat must carry REV_ACTIVE=1 (the recursion
# guard) and must run against the repo root — neither is visible in the arguments alone.
[ -n "${SHIM_ARGS_FILE:-}" ] && printf '%s\n' "$@" > "$SHIM_ARGS_FILE"
[ -n "${SHIM_ARGS_FILE:-}" ] && printf 'REV_ACTIVE=%s\ncwd=%s\n' "${REV_ACTIVE:-unset}" "$PWD" >> "$SHIM_ARGS_FILE.env"
if [ "${1:-}" = login ] && [ "${2:-}" = status ]; then
  [ "${SHIM_MODE:-ok}" = notauth ] && { echo "Not logged in"; exit 1; }
  echo "Logged in using ChatGPT"; exit 0
fi
OUT=""; prev=""
for a in "$@"; do [ "$prev" = "-o" ] && OUT=$a; prev=$a; done
STDIN=$(cat); [ -n "${SHIM_ARGS_FILE:-}" ] && printf '%s' "$STDIN" > "$SHIM_ARGS_FILE.stdin"
case "${SHIM_MODE:-ok}" in
  notauth)    echo '{"type":"error","message":"Not logged in; run codex login"}'; exit 1;;
  ratelimit)  echo '{"type":"error","message":"You have hit your usage limit (429)"}'; exit 1;;
  empty)      echo '{"type":"turn.completed"}'; exit 0;;
  badjson)    echo '{"type":"turn.completed"}'; echo 'not json' > "$OUT"; exit 0;;
  native)     cat "$SHIM_FIXTURE_DIR/codex-stream.ndjson"; cp "$SHIM_FIXTURE_DIR/codex-review-native.txt" "$OUT"; exit 0;;
  native_bad) cat "$SHIM_FIXTURE_DIR/codex-stream.ndjson"; cp "$SHIM_FIXTURE_DIR/codex-review-native-bad.txt" "$OUT"; exit 0;;
  # a failing run whose MODEL OUTPUT merely quotes a 401 (agent_message → `text:` in the log): must NOT read as auth
  noise401)   echo '{"type":"item.completed","item":{"id":"i9","type":"agent_message","text":"the endpoint answers 401 Unauthorized on expiry"}}'; echo '{"type":"turn.completed"}'; exit 1;;
  noise401exec) echo '{"type":"item.started","item":{"id":"i9","type":"command_execution","command":"rg -n \"401 unauthorized\" src"}}'; echo '{"type":"item.completed","item":{"id":"i9","type":"command_execution","command":"rg -n \"401 unauthorized\" src","exit_code":1}}'; echo '{"type":"turn.completed"}'; exit 1;;
  *)          cat "$SHIM_FIXTURE_DIR/codex-stream.ndjson"; cp "$SHIM_FIXTURE_DIR/findings-valid.json" "$OUT"; exit 0;;
esac
